# Run npm run setup to create .env safely for local use.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
APP_URL=http://localhost:8000
DATABASE_DRIVER=sqlite
DATA_DIR=./data
MONGO_URI=
MONGO_DB_NAME=rracer
JWT_SECRET=
ADMIN_EMAIL=admin@rracer.local
ADMIN_PASSWORD=
ADMIN_NAME=R Racer Admin
ADMIN_PHONE=
SEED_DEMO=true
TRUST_PROXY=0
MAX_IMAGES_PER_CAR=30
MAX_IMAGE_MB=10
# Optional for password-reset email only. Enquiries open in the customer's email app.
# For password recovery SMTP see docs/GMAIL-SETUP.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Initial enquiry recipient fallback; Admin > Settings > Enquiry recipient email takes precedence.
ADMIN_NOTIFICATION_EMAIL=
