# Copy to .env.supabase for local setup/migration. Keep your original .env unchanged.
DATABASE_DRIVER=supabase
# Connect > Session pooler > URI. Replace its password (URL-encode special characters).
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Settings > API Keys > Secret keys. Server only; NEVER VITE_ or browser code.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=rracer-images
SUPABASE_POOL_MAX=5
SUPABASE_DB_SSL=true
# Only needed if certificate verification fails. Download CA from Supabase database settings.
SUPABASE_CA_CERT_PATH=
SUPABASE_CA_CERT=
# Local access to your cloud data. Do not import demo cars into Supabase.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
APP_URL=http://localhost:8000
SEED_DEMO=false
