NODE_ENV=production
HOST=0.0.0.0
APP_URL=https://www.rracerltd.com
DATABASE_DRIVER=mariadb

# Hostinger MariaDB 11.8.9 configuration
# For Node.js running on the same Hostinger server, host is usually localhost or 127.0.0.1
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u911703995_rracer
MYSQL_USER=u911703995_rracer_user
MYSQL_PASSWORD=REPLACE_WITH_YOUR_MARIADB_PASSWORD
MYSQL_POOL_MAX=10
MYSQL_SSL=false

# Maintenance Mode toggle: set to true during final migration cutover
MAINTENANCE_MODE=false

# Security & Business configuration
JWT_SECRET=GENERATE_A_NEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_EMAIL=REPLACE_WITH_YOUR_EXISTING_ADMIN_EMAIL
ADMIN_PASSWORD=
ADMIN_NAME=R Racer Admin
ADMIN_PHONE=
SEED_DEMO=false
TRUST_PROXY=1
MAX_IMAGES_PER_CAR=30
MAX_IMAGE_MB=10
ADMIN_NOTIFICATION_EMAIL=

# Optional SMTP for password recovery. General vehicle enquiries open drafts and require no SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
