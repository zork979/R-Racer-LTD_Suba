NODE_ENV=production
HOST=0.0.0.0
APP_URL=https://www.rracerltd.com
DATABASE_DRIVER=supabase
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=rracer-images
SUPABASE_POOL_MAX=5
SUPABASE_DB_SSL=true
SUPABASE_CA_CERT=
JWT_SECRET=GENERATE_A_NEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Use the existing admin email AFTER migration. Existing passwords are not overwritten.
ADMIN_EMAIL=REPLACE_WITH_YOUR_EXISTING_ADMIN_EMAIL
# Needed only to bootstrap a NEW empty database; not needed after importing an existing admin.
ADMIN_PASSWORD=
ADMIN_NAME=R Racer Admin
ADMIN_PHONE=
SEED_DEMO=false
TRUST_PROXY=1
MAX_IMAGES_PER_CAR=30
MAX_IMAGE_MB=10
# Initial recipient fallback; Admin > Settings > Enquiry recipient email takes precedence.
ADMIN_NOTIFICATION_EMAIL=
# Optional for password-reset emails. Enquiry drafts require no SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
